# Experiment FM 105.9 Configuration
# Copy this file to .env and fill in your own values.

# --- Station ---
STATION_NAME=Experiment FM 105.9
MUSIC_DIR=C:/sourceCode/YT_Downloader/downloads

# --- DJ LLM (main brain, writes DJ scripts) ---
LLM_ENDPOINT=http://127.0.0.1:20128/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=1.2

# --- TTS ---
TTS_MODEL=F5-TTS
DJ_GENDER=male
TTS_SPEED=1.0
MUSIC_LUFS=-16.0
MUSIC_MAX_GAIN_DB=8.0
# Bruce feature: how low the song intro sits under the DJ voice when talking over it (0.0-1.0)
BRUCE_DUCK=0.22
# Bruce gate: only ride the intro when the script is short, the intro is real, and the
# ride gap (voice_len - intro) is small enough that no dead air appears.
BRUCE_MAX_VOICE_S=18
BRUCE_MIN_INTRO_S=10
BRUCE_MAX_GAP_S=4
# Talk-up: when the DJ wants to hit the post but the script is long / the intro short,
# the music comes up (from the top) in the last TALKUP_LEAD_S seconds and swells from
# TALKUP_DUCK to full right as the DJ finishes.
TALKUP_LEAD_S=2.5
TALKUP_DUCK=0.5
# TTS_CFG_STRENGTH=

# --- Rotating DJ ---
SHIFT_HOURS=3

# --- Session recording (--record) ---
# Records the final on-air mix to one MP3 (phones / car / SD friendly).
# RECORD_BITRATE: MP3 CBR bitrate (192k is a good size/quality balance)
RECORD_BITRATE=192k

# --- Audio output ---
# Output device name substring (blank = Windows default). BT: prefer A2DP, e.g. NeraBox
AUDIO_OUTPUT=
SAMPLERATE=44100
STATION_IDENT=station_ident.wav

# --- For You Zone: separate LISTENER LLM (its own brain, own credentials) ---
LISTENER_LLM_ENDPOINT=http://127.0.0.1:20128/v1/chat/completions
LISTENER_LLM_API_KEY=your-listener-api-key-here
LISTENER_LLM_MODEL=cbai/deepseek-v4.1-flash(medium)
LISTENER_LLM_FALLBACK_ENDPOINT=https://bandelbanget.xyz/v1/chat/completions
LISTENER_LLM_FALLBACK_API_KEY=your-fallback-api-key-here
LISTENER_LLM_FALLBACK_MODEL=deepseek-v4.1-flash
LISTENER_LLM_TEMPERATURE=1.15

# --- For You Zone: scheduling (code-enforced, time-of-day aware) ---
FYO_MIN_GAP_SONGS=5
FYO_BUSY_START=17
FYO_BUSY_END=23
FYO_BUSY_CHANCE=0.35
FYO_OFF_CHANCE=0.10
FYO_BUSY_MSGS_MIN=4
FYO_BUSY_MSGS_MAX=5
FYO_OFF_MSGS_MIN=2
FYO_OFF_MSGS_MAX=3
FYO_QUESTION_CHANCE=0.25
FYO_REQUEST_CHANCE=0.25
